# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_ALLOWED_ORIGINS=http://localhost:3000

# ── PostgreSQL (EU-region Azure Database for PostgreSQL Flexible) ─────────────
DATABASE_URL=postgresql+asyncpg://pharmawatch:password@localhost:5432/pharmawatch
DATABASE_SYNC_URL=postgresql://pharmawatch:password@localhost:5432/pharmawatch

# ── Redis (Azure Cache for Redis) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant vector DB ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pharmawatch_mentions

# ── Azure Blob Storage (EU region) ───────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER_RAW=raw-mentions
AZURE_BLOB_CONTAINER_EXPORTS=exports

# ── LLM — Ollama (Mistral-7B-Instruct self-hosted) ───────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# ── OpenAI (AI Mode search — GPT-4o-mini) ────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Reddit API ────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=pharmawatch/1.0 by YourUsername

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Licensed social data provider (Tier 3 — optional) ────────────────────────
LICENSED_API_PROVIDER=                     # talkwalker | meltwater | brandwatch
LICENSED_API_KEY=
LICENSED_API_BASE_URL=

# ── Google Trends ─────────────────────────────────────────────────────────────
# pytrends uses no API key; set proxy if rate-limited in prod
GOOGLE_TRENDS_PROXY=                       # optional: http://proxy:port

# ── GDPR / Compliance ────────────────────────────────────────────────────────
DPIA_PROCESSING_ENABLED=false              # MUST be true only after DPIA is documented
MENTION_RETENTION_DAYS=90                  # raw_text wiped after this period
AGGREGATE_RETENTION_DAYS=730               # aggregated stats kept 2 years
LAWFUL_BASIS=legitimate_interest           # legitimate_interest | consent | contract

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── NLP Model paths (HuggingFace cache or local path) ─────────────────────────
HF_CACHE_DIR=/app/.cache/huggingface
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
TOPIC_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
TRANSLATION_MODEL_PREFIX=Helsinki-NLP/opus-mt

# ── Notification (adverse event routing) ─────────────────────────────────────
PHARMACOVIGILANCE_EMAIL=pharmacovigilance@yourorg.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pharmawatch.eu
