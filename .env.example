# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                        # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_ALLOWED_ORIGINS=http://localhost:3000  # comma-separated for multiple origins
LOG_LEVEL=INFO

# ── PostgreSQL (EU-region, self-hosted or managed) ───────────────────────────
DATABASE_URL=postgresql+asyncpg://pharmawatch:password@localhost:5432/pharmawatch
DATABASE_SYNC_URL=postgresql://pharmawatch:password@localhost:5432/pharmawatch

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant vector DB ─────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pharmawatch_mentions
QDRANT_PATH=data/qdrant_local              # embedded on-disk fallback if QDRANT_URL is down

# ── OpenAI (AI Mode search, deep insights, PR24, summaries) ──────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
AI_WEB_SEARCH=true                         # enable the Responses-API web_search tool

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Embeddings (sentence-transformers for mention vectors) ───────────────────
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ── GDPR / Compliance ────────────────────────────────────────────────────────
DPIA_PROCESSING_ENABLED=false              # MUST be true only after DPIA is documented
MENTION_RETENTION_DAYS=90                  # raw_text wiped after this period
LAWFUL_BASIS=legitimate_interest           # legitimate_interest | consent | contract

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
